# Entorno general
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de Datos PostgreSQL 16
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/bitacora_asados?schema=public

# Better Auth Secret (Generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET=cambiar_este_secreto_super_seguro_en_produccion_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# Usuario Administrador Inicial para Seed
SEED_ADMIN_EMAIL=asador@bitacora.local
SEED_ADMIN_PASSWORD=AsadoMaster2026!
SEED_ADMIN_NAME="Maestro Asador"

# Almacenamiento Local (Carpeta absoluta o relativa fuera de /public)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=../../uploads_data

# Configuración de Worker & Cola
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2

# Cloudflare Tunnel (Opcional para exposición segura)
CLOUDFLARE_TUNNEL_TOKEN=
