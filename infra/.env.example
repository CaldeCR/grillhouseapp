# Entorno Docker
NODE_ENV=production
APP_URL=http://localhost:3000

# Base de Datos PostgreSQL en contenedor
POSTGRES_DB=bitacora_asados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_prod
DATABASE_URL=postgresql://postgres:postgres_secure_pass_prod@postgres:5432/bitacora_asados?schema=public

# Better Auth Secret
BETTER_AUTH_SECRET=prod_secret_must_be_random_and_at_least_32_characters_long
BETTER_AUTH_URL=http://localhost:3000

# Seed User
SEED_ADMIN_EMAIL=asador@bitacora.local
SEED_ADMIN_PASSWORD=AsadoMaster2026!
SEED_ADMIN_NAME="Maestro Asador"

# Storage montado en contenedor
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/data/uploads

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
